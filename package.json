{
  "name": "paseo-github-pr",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub pull request monitoring, workspace automation, and review workflows for Paseo",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuruiz/paseo-github-pr.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --maxWorkers=1 --bail=1"
  },
  "dependencies": {
    "@getpaseo/client": "0.8.0",
    "entities": "6.0.1",
    "marked": "18.0.13",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
